# ~/.config/mise/config.toml が変わったときだけ `mise install` を走らせる。
# (run_onchange_after_20-mise-install.sh.tmpl の Windows 版)
# 下のハッシュは chezmoi がテンプレート展開時に埋め込む。内容が変われば
# スクリプト本文が変わり、chezmoi が再実行してくれる。
#
# config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

$ErrorActionPreference = 'Stop'
$PSNativeCommandUseErrorActionPreference = $false

function Write-Log($msg)  { Write-Host "==> $msg" -ForegroundColor Blue }
function Write-Warn($msg) { Write-Host "警告: $msg" -ForegroundColor Yellow }

$binDir = Join-Path $HOME '.local\bin'
if ($env:PATH -notlike "*$binDir*") {
    $env:PATH = "$binDir;$env:PATH"
}

if (-not (Get-Command mise -ErrorAction SilentlyContinue)) {
    Write-Warn 'mise が見つからないのでツールのインストールをスキップします'
    exit 0
}

Write-Log 'mise でツールをインストールします (時間がかかります)'
mise install
if ($LASTEXITCODE -ne 0) {
    # Windows 版バイナリが無いツールが 1 つあるだけで apply 全体を落としたくない。
    # どれが落ちたかは `mise ls` / `mise install <tool>` で確認する。
    Write-Warn "mise install が一部失敗しました (exit $LASTEXITCODE)。mise ls で確認してください。"
}

mise reshim 2>&1 | Out-Null
