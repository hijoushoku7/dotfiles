{{/*
  chezmoi 自身の設定。`chezmoi init` のときだけ評価される。
  docs: https://www.chezmoi.io/reference/target-types/#configuration-file
*/ -}}

# OS の判定は各テンプレート側で .chezmoi.os / .chezmoi.kernel.osrelease から
# 直接おこなう。ここに [data] として持たせると、環境が変わったときに
# `chezmoi init` で再生成するまで古い値が使われてしまうため。

# Windows ではスクリプトを一切実行しないので [interpreters] は要らない。
# .chezmoiscripts/ に残っているのは *.sh だけで、それは .chezmoiignore が
# Windows で丸ごと落としている。

[edit]
    command = "nvim"

[git]
    autoCommit = true
    autoPush = true
