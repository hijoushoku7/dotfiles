{{- /* WSL 判定: /proc/sys/kernel/osrelease に microsoft / WSL が入る。
       このファイルは Windows ネイティブでは .chezmoiignore で除外されるので
       .chezmoi.kernel は必ず存在する。 */ -}}
{{- $osrelease := lower (get .chezmoi.kernel "osrelease") -}}
{{- $isWSL := or (contains "microsoft" $osrelease) (contains "wsl" $osrelease) -}}
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="agnoster"

plugins=(
  git
  gh
  zsh-bat
  zsh-autosuggestions
  sudo
  extract
  z  
)

# activating tools
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
fi
export PATH="$HOME/.local/bin:$PATH"

source $ZSH/oh-my-zsh.sh

command -v mise >/dev/null && eval "$(mise activate zsh)"

# Starship
command -v starship >/dev/null && eval "$(starship init zsh)"

# github cli
if type brew &>/dev/null
then
  FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"

  autoload -Uz compinit
  compinit
fi

# fzf history
function fzf-select-history() {
    BUFFER=$(history -n -r 1 | fzf --query "$LBUFFER" --reverse)
    CURSOR=$#BUFFER
    zle reset-prompt
}
zle -N fzf-select-history
bindkey '^r' fzf-select-history

#EDITOR
export EDITOR=nvim

#alias
alias ls='eza --icons --group-directories-first'
alias la='eza -a --icons --group-directories-first'
alias ll='eza -la --icons --group-directories-first --git'
alias lt='eza --tree --level=2 --icons'
alias rm='rm -v'
alias mv='mv -v'
alias cp='cp -v'
alias cat='bat'

#tmux
alias ta='tmux attach'
alias tn='tmux new'
alias t='tmux'
alias tls='tmux ls'

#tools
alias cm='chezmoi'
alias cdx='codex'
alias cld='claude'
alias lg='lazygit'
alias hd='hunk diff'
alias hpath='hunk skill path'


{{- if $isWSL }}
# ---------------------------------------------------------------------------
# WSL 専用
# ---------------------------------------------------------------------------
# Windows ホスト側の IP (WSL2 の NAT 越しに Windows のサービスへ繋ぐとき用)
export WSL_HOST_IP="$(ip route show default 2>/dev/null | awk '{print $3; exit}')"
# Windows 側の PATH が丸ごと繋がっていて重い / which が汚れる場合は
# /etc/wsl.conf に [interop] appendWindowsPath=false を書いて wsl --shutdown。

# クリップボード連携
alias pbcopy='clip.exe'
alias pbpaste='powershell.exe -NoProfile -Command Get-Clipboard | tr -d "\r"'

# Windows 側で開く (wslu の wslview があればブラウザにも使う)
if command -v wslview >/dev/null 2>&1; then
  export BROWSER=wslview
  alias open='wslview'
else
  alias open='explorer.exe'
fi
alias e='explorer.exe .'

# Windows のホームへ
if command -v wslpath >/dev/null 2>&1 && command -v cmd.exe >/dev/null 2>&1; then
  winhome() { cd "$(wslpath "$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')")"; }
fi
{{- end }}
